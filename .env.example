APP_NAME="Canchas App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── BASE DE DATOS (MySQL 8) ─────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=canchas
DB_USERNAME=root
DB_PASSWORD=

# ─── REDIS ───────────────────────────────────────────────────
# REQUERIDO en Fase 4. Instalar Redis para Windows antes de usarlo.
# Descarga: https://github.com/tporadowski/redis/releases
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── SESIÓN Y COLAS ──────────────────────────────────────────
# Usar 'database' localmente hasta que Redis esté instalado
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=canchas_

# ─── CORREO ──────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@canchasapp.pe"
MAIL_FROM_NAME="${APP_NAME}"

# ─── PASARELA DE PAGO (excluida del alcance actual) ──────────
# Descomentar cuando se implemente la integración de pagos
# CULQI_PUBLIC_KEY=
# CULQI_SECRET_KEY=
# CULQI_WEBHOOK_SECRET=

# ─── NOTIFICACIONES (excluidas del alcance actual) ───────────
# FCM_SERVER_KEY=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ─── VITE ────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
